{
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/ris-api/:path*",
      "destination": "https://data.bka.gv.at/ris/api/:path*"
    },
    {
      "source": "/ris-doc/:path*",
      "destination": "/api/ris-doc?path=:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "regions": [
    "fra1"
  ]
}
